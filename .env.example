# install.sh creates .env from this file and fills in the secrets.
# Never commit .env.

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Encrypts the API tokens Atlas stores for Incident IQ and the others.
# install.sh creates it. If it is lost, the tokens must be entered again.
# Generate one by hand with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ATLAS_ENCRYPTION_KEY=

# Names and addresses people will type to reach Atlas, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed once Atlas is served over HTTPS, e.g. https://atlas.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=

# Port Atlas listens on, on the host.
ATLAS_PORT=8000
