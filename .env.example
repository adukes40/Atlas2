# install.sh creates .env from this file and fills in the secrets.
# Never commit .env.

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Encrypts the API tokens Atlas stores for Incident IQ and the others.
# install.sh creates it. If it is lost, the tokens must be entered again.
# Generate one by hand with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ATLAS_ENCRYPTION_KEY=

# Names and addresses people will type to reach Atlas, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# install.sh adds https://ATLAS_HTTPS_HOST here when HTTPS is on.
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTPS (optional). Set the name people will type, e.g. atlas.example.org,
# and an IONOS DNS API key (prefix.secret) for the domain it is under, then
# run install.sh. Caddy gets a free Let's Encrypt certificate through DNS, so
# the server does not need to be reachable from the internet. Leave the name
# empty for plain HTTP. install.sh sets COMPOSE_PROFILES and ATLAS_BIND.
ATLAS_HTTPS_HOST=
ATLAS_DNS_API_TOKEN=

POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=

# Port Atlas listens on, on the host.
ATLAS_PORT=8000

# The nightly sync for Reports runs at this hour (0-23) in this time zone.
ATLAS_SYNC_HOUR=2
ATLAS_TIME_ZONE=America/New_York
